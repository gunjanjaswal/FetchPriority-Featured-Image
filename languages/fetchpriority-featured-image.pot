msgid "Presets add theme-specific logo/header class exclusions so the priority budget is spent on the real hero image. Divi & Elementor already work out of the box."
msgstr ""

#: fetchpriority-featured-image.php:896
msgid "Preload (hero featured image)"
msgstr ""

#: fetchpriority-featured-image.php:901
msgid "Preload featured image"
msgstr ""

#: fetchpriority-featured-image.php:903
msgid "Emit <link rel=\"preload\" as=\"image\"> in <head> on singular pages."
msgstr ""

#: fetchpriority-featured-image.php:904
msgid "Strongest LCP signal. The learned/manual LCP is used when available, otherwise the featured image."
msgstr ""

#: fetchpriority-featured-image.php:908
msgid "Modern format preload"
msgstr ""

#: fetchpriority-featured-image.php:910
msgid "Also preload AVIF/WebP variants when sibling files exist on disk."
msgstr ""

#: fetchpriority-featured-image.php:911
msgid "Detects \"file.avif\" / \"file.webp\" or \"file.jpg.avif\" / \"file.jpg.webp\" siblings (works with ShortPixel, Imagify, Optimole, and similar). Browsers automatically pick the supported type."
msgstr ""

#: fetchpriority-featured-image.php:921
msgid "Fonts & connections"
msgstr ""

#: fetchpriority-featured-image.php:922
msgid "For text heroes & CDNs"
msgstr ""

#: fetchpriority-featured-image.php:927
msgid "Preload text-LCP font"
msgstr ""

#: fetchpriority-featured-image.php:929
msgid "When the measured LCP is a block of text, preload the web font it uses."
msgstr ""

#: fetchpriority-featured-image.php:930
msgid "Text is the LCP on a huge number of pages. Preloading the exact font (self-hosted or Google Fonts) removes the render delay while the browser waits for it. Learned from real visitors, per template."
msgstr ""

#: fetchpriority-featured-image.php:934
msgid "CDN preconnect"
msgstr ""

#: fetchpriority-featured-image.php:936
msgid "Open an early connection to the host serving your hero image or font when it is on another domain."
msgstr ""

#: fetchpriority-featured-image.php:937
msgid "Emits <link rel=\"preconnect\"> + dns-prefetch for the exact cross-origin host the hero loads from (image CDN, Google Fonts). Saves a DNS + TLS round trip on the critical path. Same-origin heroes need nothing, so nothing is emitted."
msgstr ""

